{
  "id": "focusclaw",
  "name": "FocusClaw",
  "description": "Task context for OpenClaw. Read status, create tasks, update work, and complete FocusClaw tasks from agent workflows.",
  "version": "2026.9.1-1",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiUrl": {
        "type": "string",
        "description": "FocusClaw API URL. Defaults to http://localhost:3001",
        "default": "http://localhost:3001"
      },
      "apiKey": {
        "type": "string",
        "description": "FocusClaw API key for authentication"
      },
      "workspaceSlug": {
        "type": "string",
        "description": "Default workspace slug to operate on"
      },
      "defaultProjectId": {
        "type": "string",
        "description": "Default project ID for task operations"
      }
    }
  },
  "contracts": {
    "tools": [
      "focusclaw_plain_text_command",
      "focusclaw_list_open_tasks",
      "focusclaw_list_due_tasks",
      "focusclaw_find_task",
      "focusclaw_create_task",
      "focusclaw_list_tasks",
      "focusclaw_get_task",
      "focusclaw_update_task",
      "focusclaw_complete_task",
      "focusclaw_delete_task"
    ]
  }
}
